# Copy to `.env` for LOCAL development only. Nothing in AWS reads this file --
# each deployment target supplies these as real environment variables, which is
# the entire point of reading them from the environment rather than a config
# file baked into the image.

# Local Compose stack (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg://postgres:devpassword@localhost:5432/fieldnotes

# Which deployment target this process is running on. Every deployment sets a
# different value; that is how the demo proves three targets reached one
# database.
DEPLOY_TARGET=local
