{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "ARAgentCoreDemo",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "ARAgentCoreDemo"
  },
  "runtimes": [
    {
      "name": "ARExpenseAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/ARExpenseAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "BEDROCK_MODEL_ID",
          "value": "deepseek.v3.2"
        },
        {
          "name": "BEDROCK_MAX_TOKENS",
          "value": "600"
        }
      ]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}