{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "ARAgentCoreDemo",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "ARAgentCoreDemo"
  },
  "runtimes": [
    {
      "name": "ARExpenseAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/ARExpenseAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "envVars": [
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "BEDROCK_MODEL_ID",
          "value": "deepseek.v3.2"
        },
        {
          "name": "BEDROCK_MAX_TOKENS",
          "value": "600"
        }
      ],
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "arToolGW",
      "protocolType": "MCP",
      "description": "Shared agent tools",
      "targets": [
        {
          "name": "websearch",
          "targetType": "connector",
          "connectorId": "web-search",
          "configurations": [
            {
              "name": "WebSearch",
              "description": "",
              "parameterValues": {},
              "parameterOverrides": []
            }
          ]
        }
      ],
      "authorizerType": "AWS_IAM",
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}